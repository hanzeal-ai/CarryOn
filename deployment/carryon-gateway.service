[Unit]
Description=CarryOn cloud gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=carryon
Group=carryon
WorkingDirectory=/opt/carryon/current
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/opt/carryon/current/release.env
ExecStart=/usr/bin/python3.11 -m carryon.gateway serve --config /etc/carryon/gateway.json --port 8780
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
MemoryMax=256M
TasksMax=128

[Install]
WantedBy=multi-user.target
